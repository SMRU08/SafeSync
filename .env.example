# ==============================================================================
# SafeSync — Production Environment Variable Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in your deployment directory:
#      cp .env.example .env
# 2. Populate the placeholder values with your actual deployment secrets.
# 3. Restrict permissions:
#      chmod 600 .env
# 4. NEVER commit the real '.env' file to version control.
# ==============================================================================

# --- Application Environment ---
# Options: 'development', 'test', 'production'
APP_ENV=production
DEBUG=false
APP_NAME="SafeSync"

# --- Server Bind Configuration ---
HOST=0.0.0.0
PORT=8000

# --- Core Security & Secret Keys ---
# In production, SECRET_KEY and JWT_SECRET_KEY MUST be set to strong, randomly-generated strings.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=YOUR_PRODUCTION_SECRET_KEY_HEX_MIN_32_CHARS
JWT_SECRET_KEY=YOUR_PRODUCTION_JWT_SECRET_KEY_HEX_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS Allowed Origins ---
# Comma-separated list of trusted web origins allowed to access the API.
# In production, do NOT use '*' or leave blank.
# Example: "https://soc.facility.company.com,https://dashboard.local"
CORS_ALLOWED_ORIGINS=https://your-production-dashboard.example.com

# --- Database Connection ---
# Edge deployment with SQLite:
DATABASE_URL=sqlite:///./safesync.db
# Centralized enterprise deployment with PostgreSQL:
# DATABASE_URL=postgresql://safesync_user:YOUR_DATABASE_PASSWORD@postgres-host:5432/safesync

# --- Camera & CCTV Credentials (Optional) ---
# Used if camera feeds require basic or digest authentication
CAMERA_USERNAME=YOUR_CCTV_STREAM_USERNAME
CAMERA_PASSWORD=YOUR_CCTV_STREAM_PASSWORD
# Optional per-camera RTSP source overrides:
# CAMERA_CAMERA_01_SOURCE=rtsp://YOUR_CCTV_USER:YOUR_CCTV_PASS@192.168.1.100:554/stream1
# CAMERA_CAMERA_02_SOURCE=rtsp://YOUR_CCTV_USER:YOUR_CCTV_PASS@192.168.1.101:554/stream1

# --- External Alert Providers (Optional) ---
# Webhook Provider (e.g. Slack, Teams, Enterprise SIEM)
ALERT_WEBHOOK_ENABLED=false
WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/ENDPOINT
WEBHOOK_SECRET=YOUR_WEBHOOK_SIGNING_SECRET

# Email / SMTP Alert Provider
ALERT_EMAIL_ENABLED=false
EMAIL_HOST=smtp.company.com
EMAIL_PORT=587
EMAIL_USERNAME=alerts@company.com
EMAIL_PASSWORD=YOUR_SMTP_EMAIL_PASSWORD
EMAIL_FROM_ADDRESS=safesync-alerts@company.com
EMAIL_RECIPIENTS=safety-officer@company.com,soc-team@company.com

# SMS Alert Provider (e.g. Twilio or Telco Gateway)
ALERT_SMS_ENABLED=false
SMS_PROVIDER=generic
SMS_API_KEY=YOUR_SMS_GATEWAY_API_KEY
SMS_API_SECRET=YOUR_SMS_GATEWAY_API_SECRET
SMS_FROM_NUMBER=+15550199999
SMS_RECIPIENT_NUMBERS=+15550100001,+15550100002

# --- Storage & Evidence Retention ---
EVIDENCE_STORAGE_DIR=outputs/evidence
EVIDENCE_RETENTION_DAYS=30
LOG_FILE_PATH=outputs/logs/safesync.log
