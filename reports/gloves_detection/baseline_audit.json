  "root_cause_analysis": {
    "primary_failure_mode": "Severe class under-representation and background penalty gradient",
    "findings": [
      {
        "factor": "Dataset Imbalance",
        "description": "In the training dataset (data/processed/safesync), gloves have only 1,521 instances compared to 3,476 safety vests and 2,819 helmets. Only 17.8% of images contain glove annotations.",
        "impact": "HIGH"
      },
      {
        "factor": "Unannotated Background Penalization",
        "description": "Historical sub-datasets (e.g. hard_hat_workers with 7,035 images, construction_ppe with 1,124 images) contain workers with visible hands/gloves but zero glove labels. When trained jointly, these unannotated gloves acted as false negatives, actively training the model to suppress glove detections.",
        "impact": "CRITICAL"
      },
      {
        "factor": "Small-Object Resolution Limit",
        "description": "Median relative area of gloves is 0.0104. At inference size 384x384, average gloves are only ~39x39 pixels, and distant CCTV hands drop below 14x14 pixels. Deep feature maps (P5 stride 32) lack sufficient spatial resolution for hands.",
        "impact": "HIGH"
      },
      {
        "factor": "Confidence Calibration",
        "description": "Because glove detections have lower confidence (often 0.12-0.20), the 0.22 threshold discards over 30% of valid candidates before NMS.",
        "impact": "MEDIUM"
      },
      {
        "factor": "Color and Material Diversity",
        "description": "Existing training examples heavily emphasize bright yellow/orange rubber gloves, performing poorly on leather, white cloth, blue nitrile, and dark industrial mechanics gloves.",
        "impact": "HIGH"
      }
    ]
  },
