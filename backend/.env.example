# ========================================================
# SafeSync — Backend Environment Variables Template
# Use these in your Render / Cloud Dashboard Environment Variables
# ========================================================

# Application Configuration
APP_NAME="SafeSync"
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS Configuration
# Add your production frontend URL (Vercel or Netlify)
# Multiple URLs can be separated by commas:
CORS_ALLOWED_ORIGINS=https://safesync.vercel.app,https://safesync.netlify.app

# Database Configuration
# Default is persistent SQLite. For Render PostgreSQL, provide:
# postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./safesync.db

# Security & Authentication (Generate with: openssl rand -hex 32)
SECRET_KEY=generate_a_secure_random_hex_string_32_chars
JWT_SECRET_KEY=generate_a_secure_jwt_secret_key_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_ENABLED=false

# Optional Alert Integrations
ALERT_WEBHOOK_ENABLED=false
# WEBHOOK_URL=https://your-webhook-endpoint.com/api/alerts
# WEBHOOK_SECRET=your_webhook_signing_secret

ALERT_EMAIL_ENABLED=false
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USERNAME=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_FROM_ADDRESS=alerts@safesyncvision.com
# EMAIL_RECIPIENTS=safety-officer@company.com

ALERT_SMS_ENABLED=false
